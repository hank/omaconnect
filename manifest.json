{
  "schemaVersion": 1,
  "id": "omaconnect",
  "name": "OmaConnect",
  "version": "1.0.0",
  "author": "Jitendra Dara (jitendradara12)",
  "description": "Integrates KDE Connect device state, battery status, and device actions into Omarchy.",
  "license": "MIT",
  "homepage": "https://github.com/jitendradara12/omaconnect",
  "repository": "https://github.com/jitendradara12/omaconnect",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
